{
  "name": "iep-servicemonitor-ui",
  "version": "0.4.3-rc",
  "description": "Infinity Service Monitor",
  "scripts": {
    "prestart": "npm install",
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 80 --disable-host-check",
    "build": "ng build --configuration=production --base-href /servicemonitor/ --deploy-url /servicemonitor/",
    "watch": "ng build --watch --configuration development",
    "update-version": "npm version $npm_config_release_version --allow-same-version --git-tag-version false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/localize": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/node": "^22.0.0",
    "sass": "^1.90.0",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": "^22.0.0"
  }
}
